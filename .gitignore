# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# fake storage adapter output (real client documents in dev)
/local-storage

# encrypted copies waiting to be saved to OneDrive (never commit)
/upload-queue

# automated browser tests
/e2e-mail
/e2e-storage
/e2e-queue
/test-results
/playwright-report

# eval fixtures — real-case fixtures live in the database; never commit JSON here
/evals/*.json
