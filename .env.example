# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://USER@localhost:5432/visasteps"
APP_URL="http://localhost:3000"
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to hash OTP codes and tokens.
AUTH_SECRET=""

# Adapters
#   EMAIL_PROVIDER: "fake" prints emails in the terminal; "smtp" sends real email (settings below)
#   SMS_PROVIDER:   "off" (email only, current choice) or "fake" (prints texts in the terminal)
#   STORAGE_PROVIDER: "fake" writes to ./local-storage; "onedrive" = Microsoft 365 Personal (OneDrive app folder);
#                     "graph" = Microsoft 365 Business (SharePoint). Set with: npm run setup:onedrive
EMAIL_PROVIDER="fake"
SMS_PROVIDER="off"
STORAGE_PROVIDER="fake"
LOCAL_STORAGE_DIR="./local-storage"

# Password for the seeded caseworker (dev only)
SEED_STAFF_PASSWORD=""

# Password for the seeded demo client (dev only)
SEED_CLIENT_PASSWORD=""

# Real email (EMAIL_PROVIDER="smtp"). Hostinger mailbox, same as uhalegal.com.
# Port 465 = SSL/TLS, 587 = STARTTLS.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""          # the mailbox, e.g. portal@uhalegal.com
SMTP_PASS=""          # that mailbox's password
EMAIL_FROM=""         # e.g. "UHA Legal <portal@uhalegal.com>" — must be the SMTP_USER mailbox or an alias of it
EMAIL_REPLY_TO=""     # optional, e.g. info@uhalegal.com

# Microsoft Graph. "onedrive" needs only GRAPH_CLIENT_ID (the sign-in is stored encrypted in the database).
# "graph" (SharePoint) needs all of these. Set them with: npm run setup:onedrive
# Step-by-step Microsoft setup: docs/onedrive-setup.md
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SITE_URL=""     # e.g. https://uhalegal.sharepoint.com/sites/ClientFiles
GRAPH_LIBRARY=""      # optional; default "Documents"

# Files waiting to be saved (encrypted, deleted once saved). Default ./upload-queue
UPLOAD_QUEUE_DIR=""
# Only for hosts that call /api/jobs/storage on a schedule instead of the built-in retry loop
CRON_SECRET=""
# Local testing only: "1" makes the fake storage fail, to see the retry queue at work
STORAGE_FAKE_OUTAGE=""

# Password for the seeded admin (dev only)
SEED_ADMIN_PASSWORD=""

# Virus scanning of uploads: "clamav" (live server — required) or "off" (local development only)
VIRUS_SCAN="clamav"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
