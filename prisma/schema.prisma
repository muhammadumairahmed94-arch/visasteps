generator client {
  provider      = "prisma-client-js"
  // native = this Mac; the others = the Linux server (Intel/AMD) and Docker on Apple Silicon
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASEWORKER
}

enum DocStatus {
  NEED // To do
  SENT // Checking
  OK // Done
  REDO // Please redo
}

enum ActorType {
  CLIENT
  USER
  SYSTEM
  SPONSOR
}

enum CaseStage {
  DOCUMENTS  // Sending documents (default)
  CHECKING   // Lawyer reviewing
  READY      // Ready to submit
  SUBMITTED  // Sent to Home Office
  DECISION   // Awaiting decision
}

enum GuidanceStatus {
  ACTIVE
  SUPERSEDED
}

model Firm {
  id                   String               @id @default(cuid())
  name                 String
  phone                String
  whatsapp             String? // digits only, for wa.me links
  oneDriveConfig       Json?
  nextCaseNumber       Int                  @default(1000)
  reviewDays           Int                  @default(2)
  aiEnabled            Boolean              @default(false)
  guidanceReviewMonths Int                  @default(3)
  createdAt            DateTime             @default(now())
  users                User[]
  clients              Client[]
  routes               Route[]
  auditLogs            AuditLog[]
  guidanceSources      GuidanceSource[]
  guidanceSourceTypes  GuidanceSourceType[]
}

model User {
  id                  String           @id @default(cuid())
  firmId              String
  firm                Firm             @relation(fields: [firmId], references: [id])
  role                Role             @default(CASEWORKER)
  name                String
  email               String           @unique
  passwordHash        String?
  // Authenticator-app 2FA. The secret is encrypted with AUTH_SECRET.
  totpSecret          String?
  totpEnabledAt       DateTime?
  totpLastStep        Int? // last accepted 30-second step, so a code cannot be reused
  recoveryCodes       String[] // hashed, single use
  failedLogins        Int              @default(0)
  disabledAt          DateTime? // removed from the team: cannot sign in, history kept
  lockedUntil         DateTime?
  ssoId               String?
  createdAt           DateTime         @default(now())
  clients             Client[]
  sessions            Session[]
  invites             Invite[]
  messages            Message[]
  guidanceUploaded    GuidanceSource[] @relation("guidance_uploaded_by")
  guidanceReviewed    GuidanceSource[] @relation("guidance_reviewed_by")
  guidanceOwnerRoutes Route[]          @relation("guidance_route_owner")
}

model Client {
  id               String           @id @default(cuid())
  firmId           String
  firm             Firm             @relation(fields: [firmId], references: [id])
  // Names and mobile are filled in by the client when they create their account
  firstName        String?
  lastName         String?
  mobile           String? // normalised, e.g. +447700900121
  email            String           @unique // also the client's sign-in name
  passwordHash     String?
  accountCreatedAt DateTime?
  caseRef          String
  routeId          String
  route            Route            @relation(fields: [routeId], references: [id])
  caseworkerId     String
  caseworker       User             @relation(fields: [caseworkerId], references: [id])
  plannedSubmissionDate DateTime? // set by the caseworker; used to turn date windows into exact dates
  caseStage        CaseStage        @default(DOCUMENTS)
  remindersPaused  Boolean          @default(false)
  reminderCount    Int              @default(0) // "missing documents" reminders sent (max 5)
  lastReminderAt   DateTime?
  closedAt         DateTime? // case closed: client cannot sign in, no reminders; data kept
  failedLogins     Int              @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime         @default(now())
  // Sponsor sub-accounts — a sponsor is a Client row with sponsorForClientId set
  sponsorForClientId String?
  sponsorForClient   Client?        @relation("SponsorOf", fields: [sponsorForClientId], references: [id], onDelete: Cascade)
  sponsorAccounts    Client[]       @relation("SponsorOf")
  sponsorLabel       String?        // e.g. "Partner" — shown in portal header
  visibleToClient    Boolean        @default(false) // sponsor docs shown read-only on main client portal
  documents        ClientDocument[]
  invites          Invite[]
  sessions         Session[]
  signInCodes      SignInCode[]
  uploadSessions   UploadSession[]
  messages         Message[]

  @@unique([firmId, caseRef])
  @@index([sponsorForClientId])
}

model Route {
  id               String                  @id @default(cuid())
  firmId           String
  firm             Firm                    @relation(fields: [firmId], references: [id])
  name             String
  // Folders created for every case on this route that hold no checklist items
  extraFolders     String[]
  items            ChecklistItem[]
  clients          Client[]
  guidanceOwnerId  String?
  guidanceOwner    User?                   @relation("guidance_route_owner", fields: [guidanceOwnerId], references: [id], onDelete: SetNull)
  guidanceTypes    GuidanceSourceType[]
  guidanceSources  GuidanceSourceOnRoute[]

  @@unique([firmId, name])
}

model ChecklistItem {
  id           String           @id @default(cuid())
  routeId      String
  route        Route            @relation(fields: [routeId], references: [id])
  folder       String // e.g. "01 Identity" — also decides group order
  groupLabel   String // client-facing, e.g. "Identity"
  title        String
  why          String
  howToGet     String? // plain-English steps for the client, e.g. how to download statements
  exampleImage String? // filename in public/samples/, e.g. "bank-statement.png"
  dateWindow   String? // e.g. "last 6 months" or "last 28 days" — resolved to exact dates
  typeKey      String // used in file names, e.g. "Passport"
  required     Boolean          @default(true)
  order        Int
  archivedAt   DateTime? // removed from the route; kept for clients who already sent it
  assignedTo   String    @default("CLIENT") // "CLIENT" | "SPONSOR" — who uploads this by default
  documents    ClientDocument[]
}

model ClientDocument {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id])
  status          DocStatus     @default(NEED)
  note            String?
  redoSince       DateTime? // when "Please redo" was set
  redoRemindedAt  DateTime?
  missingReason   String? // set by client via "I can't find this"
  missingAt       DateTime? // when missingReason was saved; null = not flagged
  missingResponse    String?  // caseworker's reply, shown on the client portal
  assignedToOverride String?  // null = use route default; "CLIENT" | "SPONSOR" to override
  filesShared        Boolean  @default(false) // show prior party's files to current assignee
  updatedAt          DateTime @updatedAt
  files              FileUpload[]
  uploadSessions     UploadSession[]

  @@unique([clientId, checklistItemId])
}

model FileUpload {
  id               String         @id @default(cuid())
  clientDocumentId String
  clientDocument   ClientDocument @relation(fields: [clientDocumentId], references: [id], onDelete: Cascade)
  originalName     String
  storedName       String
  folderPath       String         @default("") // where it lives (or will), segments joined by "/"
  oneDriveItemId   String? // storage item id once saved (a relative path in fake mode)
  webUrl           String? // "Open in SharePoint" link
  storageStatus    StorageStatus  @default(SAVED)
  sizeBytes        Int
  sha256           String
  uploadedAt       DateTime       @default(now())
  supersededAt     DateTime?
  uploaderKind     String         @default("CLIENT") // "CLIENT" | "SPONSOR"
  jobs             StorageJob[]
}

enum LinkKind {
  SETUP // "Create your account" — 7 days
  RESET // "Choose a new password" — 1 hour
  STAFF // new caseworker: "Set your password" — 7 days
}

/**
 * Single-use links sent by email.
 */
model Invite {
  id        String    @id @default(cuid())
  kind      LinkKind  @default(SETUP)
  // One of clientId (client account links) or userId (staff "set your password" links)
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  clientId   String?
  client     Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage      SessionStage @default(FULL)
  remember   Boolean      @default(false)
  expiresAt  DateTime
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
}

model AuditLog {
  id        String    @id @default(cuid())
  firmId    String
  firm      Firm      @relation(fields: [firmId], references: [id])
  actorType ActorType
  actorId   String?
  action    String
  targetId  String?
  ip        String?
  at        DateTime  @default(now())

  @@index([firmId, at])
}

enum SessionStage {
  FULL
  MFA // password accepted, waiting for the authenticator code (staff only)
}

/**
 * Fixed-window counters for rate limiting. Kept in the database so limits hold across servers.
 */
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/**
 * Single-use 6-digit codes for client OTP sign-in.
 * Stored hashed (HMAC-SHA256 keyed to AUTH_SECRET). Expires after 10 minutes.
 * A new code replaces any earlier unused one. Max 5 wrong attempts before the code is cancelled.
 */
model SignInCode {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([clientId])
}

enum StorageStatus {
  SAVED // confirmed in OneDrive / SharePoint
  PENDING // held encrypted on the server, being retried
  FAILED // retries used up — caseworker can retry by hand
}

enum StorageJobKind {
  UPLOAD
  MOVE // to "_Old versions" after a redo
}

/**
 * Storage work that could not be done straight away (Microsoft unreachable). Processed oldest first.
 */
model StorageJob {
  id            String         @id @default(cuid())
  kind          StorageJobKind
  fileUploadId  String
  fileUpload    FileUpload     @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)
  folderPath    String // target folder
  name          String // target file name
  tempPath      String? // encrypted copy waiting to be uploaded (UPLOAD only)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime       @default(now())
  lockedUntil   DateTime?
  createdAt     DateTime       @default(now())

  @@index([nextAttemptAt])
}

/**
 * Temporary state for a chunked upload in progress.
 * One session = one client + one document slot. Expires 24 hours after creation.
 * Chunks are stored encrypted on disk (upload-queue/upload-chunks/{id}/…) and
 * deleted when the upload completes, is cancelled, or expires.
 */
model UploadSession {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  docId        String
  doc          ClientDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  pages        Json           // PageMeta[]: { fileName, sizeBytes, sha256, totalChunks }[]
  multiPage    Boolean        @default(false)
  completingAt DateTime?      // set atomically when complete starts; prevents double-processing
  expiresAt    DateTime
  createdAt    DateTime       @default(now())

  @@index([clientId])
}

/**
 * Encrypted message between a client and their caseworker.
 * body is AES-256-GCM encrypted with purpose "message" — never stored plain.
 * readAt is set when the OTHER party first views the thread (caseworker for CLIENT messages, client for STAFF messages).
 * Only the assigned caseworker's GET marks client messages as read; admin views are silent.
 */
model Message {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  senderKind String    // "CLIENT" | "STAFF"
  staffId    String?
  staff      User?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  body       String    // encrypt(text, "message")
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([clientId])
}

/**
 * Official gov.uk guidance uploaded by admins for staff reference.
 * HTML files have extractedText for AI/display; original served as download only.
 * Stored under Guidance/{firmId}/ in OneDrive, never inside client folders.
 */
model GuidanceSource {
  id                String                  @id @default(cuid())
  firmId            String
  firm              Firm                    @relation(fields: [firmId], references: [id])
  title             String
  govukUrl          String
  publishedAt       DateTime?
  lastUpdatedAt     DateTime?
  oneDriveItemId    String
  webUrl            String?
  sizeBytes         Int
  mimeType          String                  // "application/pdf" | "text/html"
  fileName          String
  extractedText     String?                 // HTML only: plain text after stripping tags
  uploadedById      String
  uploadedBy        User                    @relation("guidance_uploaded_by", fields: [uploadedById], references: [id])
  uploadedAt        DateTime                @default(now())
  lastReviewedAt    DateTime?
  lastReviewedById  String?
  lastReviewedBy    User?                   @relation("guidance_reviewed_by", fields: [lastReviewedById], references: [id])
  status            GuidanceStatus          @default(ACTIVE)
  previousVersionId String?
  previousVersion   GuidanceSource?         @relation("guidance_versions", fields: [previousVersionId], references: [id])
  newerVersions     GuidanceSource[]        @relation("guidance_versions")
  typeId            String?
  type              GuidanceSourceType?     @relation(fields: [typeId], references: [id])
  routes            GuidanceSourceOnRoute[]

  @@index([firmId, status])
}

/** An expected source type per route (e.g. "Main appendix", "Evidence rules"). */
model GuidanceSourceType {
  id       String           @id @default(cuid())
  firmId   String
  routeId  String
  name     String
  order    Int              @default(0)
  firm     Firm             @relation(fields: [firmId], references: [id])
  route    Route            @relation(fields: [routeId], references: [id])
  sources  GuidanceSource[]
}

/** Many-to-many: one guidance source can cover multiple visa routes. */
model GuidanceSourceOnRoute {
  sourceId String
  routeId  String
  source   GuidanceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  route    Route          @relation(fields: [routeId], references: [id])

  @@id([sourceId, routeId])
}
