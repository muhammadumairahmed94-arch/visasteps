# Production settings — on the server this file is /opt/visasteps/.env (never commit it, never email it).
# Keep a copy in a password manager: it is needed to rebuild the server.
# Generate random values with:  openssl rand -hex 32

DOMAIN="portal.uhalegal.com"
APP_URL="https://portal.uhalegal.com"

# Random, 32+ characters each. AUTH_SECRET encrypts 2FA secrets and the OneDrive sign-in: never change it after launch.
AUTH_SECRET=""
POSTGRES_PASSWORD=""
CRON_SECRET=""

# Email. DigitalOcean blocks mail ports, so the live server sends through the website's relay
# (www.uhalegal.com/api/portal-mail → Hostinger as info@uhalegal.com). The secret must match PORTAL_RELAY_SECRET on Vercel.
EMAIL_PROVIDER="relay"
EMAIL_RELAY_URL="https://www.uhalegal.com/api/portal-mail"
EMAIL_RELAY_SECRET=""
# SMTP settings below are only used if EMAIL_PROVIDER="smtp" (e.g. if DigitalOcean unblocks port 465)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="portal@uhalegal.com"
SMTP_PASS=""
EMAIL_FROM="UHA Legal <portal@uhalegal.com>"
EMAIL_REPLY_TO=""
# Where operational alerts go (portal errors, OneDrive disconnected, backup missed)
ALERT_EMAIL="info@uhalegal.com"

SMS_PROVIDER="off"

# OneDrive (Microsoft 365 Personal). The sign-in itself is stored in the database by:
#   docker compose run --rm tools npm run setup:onedrive
STORAGE_PROVIDER="onedrive"
GRAPH_CLIENT_ID="e8aa5424-cf68-46c7-b6d0-3d19a4c77c43"

# Nightly encrypted backups → OneDrive (Apps → UHA Legal Client Portal → Backups)
BACKUP_AGE_RECIPIENT=""     # the PUBLIC key (age1…) — the private key stays in the password manager, never on the server

# AI document analysis — caseworker-only, off until the firm admin enables it per-firm.
# Use "bedrock" (Claude via AWS eu-west-2 London, data stays in UK) or "anthropic" (direct API).
# Leave "off" if the feature is not yet in use.
AI_PROVIDER="off"
AI_MODEL_ID=""              # e.g. anthropic.claude-sonnet-4-5-20251001-v1:0 (Bedrock) or claude-sonnet-4-6 (Anthropic)
# Bedrock — use an IAM role on EC2 where possible (no keys needed); fall back to an access key:
AWS_BEDROCK_REGION="eu-west-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Anthropic direct:
ANTHROPIC_API_KEY=""
